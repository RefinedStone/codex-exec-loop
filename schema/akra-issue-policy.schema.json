{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Akra issue policy (issue-policy.toml), schema_version 1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "description": "A missing value means 1.",
      "const": 1
    },
    "convention": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "template": {
          "description": "Issue template to apply. A relative path inside the repository, without `..`.",
          "type": "string",
          "minLength": 1
        },
        "required_sections": {
          "description": "Section titles the project requires in addition to the template.",
          "type": "array",
          "items": { "type": "string", "pattern": "\\S" }
        }
      }
    },
    "publish": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "required_validation": {
          "description": "Locked. The mandatory publish validation cannot be turned off.",
          "const": true
        },
        "spans": { "$ref": "#/$defs/spans" }
      }
    },
    "ai_handoff": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "spans": { "$ref": "#/$defs/spans" }
      }
    },
    "vault": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "user_unlock": {
          "description": "Locked. The user unlock for restore cannot be turned off.",
          "const": true
        }
      }
    },
    "code_validators": {
      "description": "Code validators the policy selects. One value: a project list replaces the user list. Each id must be in the user file's approved_code_validators; a required validator that does not run blocks publish.",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id"],
        "properties": {
          "id": { "type": "string", "pattern": "\\S" },
          "targets": {
            "description": "Default: [\"publish\"].",
            "type": "array",
            "items": { "enum": ["publish", "ai_handoff"] }
          },
          "required": { "description": "Default: true.", "type": "boolean" }
        }
      }
    },
    "approved_code_validators": {
      "description": "User file only. A project file with this table is invalid. The key is the validator id.",
      "type": "object",
      "propertyNames": { "pattern": "\\S" },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["command", "sha256"],
        "properties": {
          "command": { "description": "Absolute path of the executable.", "type": "string" },
          "sha256": {
            "description": "SHA-256 of the approved file content.",
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "timeout_seconds": { "description": "Default: 10.", "type": "integer", "minimum": 1, "maximum": 300 }
        }
      }
    }
  },
  "$defs": {
    "action": {
      "enum": ["remove", "restorable_mask", "user_confirm"]
    },
    "spans": {
      "description": "Action per sensitive span class. Built-in: secret = remove, others = restorable_mask.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "secret": { "$ref": "#/$defs/action" },
        "name": { "$ref": "#/$defs/action" },
        "path": { "$ref": "#/$defs/action" },
        "log": { "$ref": "#/$defs/action" }
      }
    }
  }
}
