{
  "name": "@refinedstone/akra-admin-game",
  "version": "0.0.0-development",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vite build --config vite.config.ts && node scripts/promote-build.mjs",
    "check": "tsc --noEmit --project tsconfig.json",
    "sprites:check": "node scripts/clean-agent-sprites.mjs --check && node scripts/validate-pr-approver-sprites.mjs",
    "sprites:clean": "node scripts/clean-agent-sprites.mjs --write",
    "sprites:approver:prepare": "node scripts/prepare-pr-approver-sprites.mjs",
    "sprites:approver:check": "node scripts/validate-pr-approver-sprites.mjs"
  },
  "devDependencies": {
    "@types/pngjs": "^6.0.5",
    "pixi.js": "^8.19.0",
    "pngjs": "^7.0.0",
    "typescript": "6.0.3",
    "vite": "8.1.4"
  }
}
