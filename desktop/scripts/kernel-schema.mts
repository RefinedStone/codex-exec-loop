// Only the JSON Schema forms exported by the Akra kernel are supported.
// Fail on new forms instead of silently widening the generated wire contract.
type Schema = {
  readonly $ref?: string;
  readonly type?: string | readonly string[];
  readonly const?: string | number | boolean | null;
  readonly enum?: readonly (string | number | boolean | null)[];
  readonly oneOf?: readonly Schema[];
  readonly anyOf?: readonly Schema[];
  readonly properties?: Readonly<Record<string, Schema>>;
  readonly required?: readonly string[];
  readonly items?: Schema;
  readonly additionalProperties?: boolean;
};

export interface KernelSpec {
  readonly protocol_version: number;
  readonly $defs: Readonly<Record<string, Schema>>;
  readonly methods: readonly { readonly name: string }[];
  readonly errors: readonly { readonly name: string; readonly code: number }[];
  readonly commands: readonly { readonly name: string; readonly effect: string }[];
}

const SUPPORTED_KEYS = new Set([
  "$ref", "type", "const", "enum", "oneOf", "anyOf", "properties", "required", "items",
  "additionalProperties", "format", "minimum", "minLength", "maxLength", "pattern", "default",
]);

export class KernelSchemaError extends Error {
  readonly location: string;

  constructor(location: string, detail: string) {
    super(`${location}: ${detail}`);
    this.name = "KernelSchemaError";
    this.location = location;
  }
}

function schemaType(schema: Schema, definitions: Readonly<Record<string, Schema>>, location: string): string {
  for (const key of Object.keys(schema)) {
    if (!SUPPORTED_KEYS.has(key)) throw new KernelSchemaError(location, `unsupported keyword ${key}`);
  }
  const parts: string[] = [];
  if (schema.$ref !== undefined) {
    const name = schema.$ref.replace("#/$defs/", "");
    if (schema.$ref !== `#/$defs/${name}` || !Object.hasOwn(definitions, name)) {
      throw new KernelSchemaError(location, `unresolved reference ${schema.$ref}`);
    }
    parts.push(name);
  }
  if (Object.hasOwn(schema, "const")) {
    parts.push(JSON.stringify(schema.const));
  } else if (schema.enum) {
    parts.push(`(${schema.enum.map((value) => JSON.stringify(value)).join(" | ")})`);
  } else if (schema.oneOf || schema.anyOf) {
    const variants = schema.oneOf ?? schema.anyOf ?? [];
    parts.push(`(${variants.map((value, index) => schemaType(value, definitions, `${location}/${index}`)).join(" | ")})`);
  } else if (Array.isArray(schema.type)) {
    parts.push(`(${schema.type.map((type) => schemaType({ ...schema, type }, definitions, location)).join(" | ")})`);
  } else {
    switch (schema.type) {
      case "object": {
        if (schema.additionalProperties === true) {
          throw new KernelSchemaError(location, "open dictionary is not supported");
        }
        const required = new Set(schema.required ?? []);
        const fields = Object.entries(schema.properties ?? {}).map(([name, value]) =>
          `readonly ${JSON.stringify(name)}${required.has(name) ? "" : "?"}: ${schemaType(value, definitions, `${location}/${name}`)};`,
        );
        parts.push(`{ ${fields.join(" ")} }`);
        break;
      }
      case "array":
        if (!schema.items) throw new KernelSchemaError(location, "array needs items");
        parts.push(`Array<${schemaType(schema.items, definitions, `${location}/items`)}>`);
        break;
      case "string":
      case "boolean":
      case "null":
        parts.push(schema.type);
        break;
      case "number":
      case "integer":
        parts.push("number");
        break;
      case undefined:
        if (parts.length === 0) throw new KernelSchemaError(location, "missing type");
        break;
      default:
        throw new KernelSchemaError(location, `unsupported type ${String(schema.type)}`);
    }
  }
  return parts.join(" & ");
}

export function renderKernelProtocol(spec: KernelSpec): string {
  for (const name of Object.keys(spec.$defs)) {
    if (!/^[A-Za-z_]\w*$/.test(name)) throw new KernelSchemaError(name, "invalid TypeScript name");
  }
  const methods = Object.fromEntries(spec.methods.map(({ name }) => [name.replace("akra/kernel/", ""), name]));
  const errors = Object.fromEntries(spec.errors.map(({ name, code }) => [name, code]));
  const effects = Object.fromEntries(spec.commands.map(({ name, effect }) => [name, effect]));
  const declarations = Object.entries(spec.$defs).map(([name, schema]) =>
    `export type ${name} = ${schemaType(schema, spec.$defs, name)};`,
  );
  return [
    "// Generated by scripts/generate-kernel-protocol.mjs. Do not edit.",
    `export const KERNEL_PROTOCOL_VERSION = ${spec.protocol_version};`,
    `export const KERNEL_METHOD = ${JSON.stringify(methods, null, 2)} as const;`,
    `export const KERNEL_ERROR = ${JSON.stringify(errors, null, 2)} as const;`,
    `export const KERNEL_COMMAND_EFFECT = ${JSON.stringify(effects, null, 2)} as const satisfies Record<KernelCommand["type"], string>;`,
    ...declarations,
  ].join("\n\n") + "\n";
}
