{
  "name": "@refinedstone/akra-desktop",
  "version": "0.0.0-development",
  "private": true,
  "description": "Akra Desktop: Electron client for akra-gateway (docs/plan/17-akra-desktop)",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "check": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "generate:protocol": "node scripts/generate-protocol.mjs",
    "e2e": "electron-vite build && node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON test/e2e/approval-flow.mjs"
  },
  "dependencies": {
    "ws": "8.22.1"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/ws": "8.18.2",
    "@vitejs/plugin-react": "6.2.1",
    "electron": "45.2.3",
    "electron-vite": "6.0.0",
    "playwright-core": "1.59.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "typescript": "7.0.2",
    "vite": "8.3.6",
    "vitest": "5.1.0",
    "zustand": "5.0.16"
  }
}
