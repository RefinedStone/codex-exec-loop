{
  "name": "@refinedstone/akra-desktop",
  "version": "0.0.0-development",
  "private": true,
  "description": "Akra Desktop: Electron client for akra-gateway (docs/plan/17-akra-desktop)",
  "main": "out/main/index.js",
  "scripts": {
    "predev": "node scripts/prepare-dev.mjs",
    "dev": "electron-vite dev",
    "blueprint": "node scripts/blueprint.mjs",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "check": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "e2e:publish": "electron-vite build && node --experimental-strip-types --disable-warning=ExperimentalWarning --disable-warning=MODULE_TYPELESS_PACKAGE_JSON test/e2e/branch-publish.mjs",
    "e2e:hunks": "electron-vite build && node --experimental-strip-types --disable-warning=ExperimentalWarning --disable-warning=MODULE_TYPELESS_PACKAGE_JSON test/e2e/hunk-actions.mjs",
    "e2e:jira": "electron-vite build && node --experimental-strip-types --disable-warning=ExperimentalWarning --disable-warning=MODULE_TYPELESS_PACKAGE_JSON test/e2e/jira-versions.mjs",
    "generate:protocol": "node scripts/generate-protocol.mjs",
    "generate:kernel-protocol": "node --experimental-strip-types --disable-warning=ExperimentalWarning scripts/generate-kernel-protocol.mjs",
    "e2e": "electron-vite build && node --experimental-strip-types --disable-warning=ExperimentalWarning --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/run-e2e.mjs",
    "postinstall": "node scripts/fix-pty-permissions.mjs"
  },
  "dependencies": {
    "@pierre/diffs": "1.6.4",
    "@shikijs/langs": "4.6.0",
    "node-pty": "1.1.0",
    "ws": "8.22.1"
  },
  "devDependencies": {
    "@tanstack/react-virtual": "3.14.26",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/ws": "8.18.2",
    "@vitejs/plugin-react": "6.2.1",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/addon-webgl": "0.19.0",
    "@xterm/xterm": "6.0.0",
    "electron": "45.2.3",
    "electron-vite": "6.0.0",
    "playwright-core": "1.59.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "typescript": "7.0.2",
    "vite": "8.3.6",
    "vitest": "5.1.0",
    "zustand": "5.0.16"
  }
}
